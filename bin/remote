#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════
#  remote — 统一远程访问 CLI
# ═══════════════════════════════════════════════════════════════════
set -uo pipefail

REMOTE_CLI_DIR="$(cd "$(dirname "$0")/.." && pwd)"
export REMOTE_CLI_DIR

# ─── 基础层始终加载 ────────────────────────────────────────────
source "$REMOTE_CLI_DIR/lib/common.sh"
source "$REMOTE_CLI_DIR/lib/config.sh"
load_config

# ─── 功能模块惰性加载 ──────────────────────────────────────────
declare -A _CMD_MODULES=(
    [connect]="detect.sh connect.sh"
    [c]="detect.sh connect.sh"
    [status]="detect.sh status.sh"
    [st]="detect.sh status.sh"
    [fix]="detect.sh fix.sh"
    [forward]="detect.sh forward.sh"
    [fwd]="detect.sh forward.sh"
    [files]="detect.sh files.sh"
    [desktop]="detect.sh desktop.sh"
    [desk]="detect.sh desktop.sh"
    [code]="detect.sh code.sh"
    [runner]="runner.sh"
    [r]="runner.sh"
    [setup]="detect.sh status.sh setup.sh"
    [install]="install.sh"
    [update]=""
    [uninstall]=""
    [config]=""
    [cfg]=""
)

_load_cmd() {
    local cmd="$1"
    local modules="${_CMD_MODULES[$cmd]:-}"
    for mod in $modules; do
        [[ " ${_LOADED_MODULES:-} " == *" $mod "* ]] && continue
        source "$REMOTE_CLI_DIR/lib/$mod"
        _LOADED_MODULES+=" $mod"
    done
}

# ─── 子命令路由 ────────────────────────────────────────────────
cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
    connect|c)
        _load_cmd connect
        cmd_connect "$@"
        ;;
    status|st)
        _load_cmd status
        cmd_status "$@"
        ;;
    fix)
        _load_cmd fix
        cmd_fix "$@"
        ;;
    forward|fwd)
        _load_cmd forward
        cmd_forward "$@"
        ;;
    files|f)
        _load_cmd files
        cmd_files "$@"
        ;;
    desktop|desk)
        _load_cmd desktop
        cmd_desktop "$@"
        ;;
    code)
        _load_cmd code
        cmd_code "$@"
        ;;
    runner|r)
        _load_cmd runner
        cmd_runner "$@"
        ;;
    setup)
        _load_cmd setup
        cmd_setup "$@"
        ;;
    install)
        _load_cmd install
        cmd_install "$@"
        ;;
    config|cfg)
        echo "配置文件: $CONFIG_ENV"
        if [[ -f "$CONFIG_ENV" ]]; then
            grep -v "KEY\|PASSWORD\|SECRET\|TOKEN" "$CONFIG_ENV" 2>/dev/null || echo "(空)"
        else
            echo "未创建，运行 'remote setup' 初始化"
        fi
        ;;
    update)
        if [[ ! -d "$REMOTE_CLI_DIR/.git" ]]; then
            die "非 git 安装，需手动更新"
        fi
        info "检查更新..."
        git -C "$REMOTE_CLI_DIR" fetch --quiet origin 2>/dev/null || { warn "网络错误"; exit 1; }
        behind=$(git -C "$REMOTE_CLI_DIR" rev-list HEAD..origin/main --count 2>/dev/null || echo "0")
        if [[ "${behind:-0}" -eq 0 ]]; then
            ok "已是最新版本 ($REMOTE_CLI_VERSION)"
        else
            info "发现 $behind 个新提交"
            if confirm "更新到最新版本？"; then
                git -C "$REMOTE_CLI_DIR" pull --ff-only && ok "已更新"
            fi
        fi
        ;;
    uninstall)
        _load_cmd uninstall
        cmd_uninstall "$@"
        ;;
    --version|-v)
        echo "remote-cli $REMOTE_CLI_VERSION"
        ;;
    --help|-h|help)
        cat << 'HELP'
用法: remote <command> [options]

连接:
  connect [host]       连接工作站终端（自动选路）
    --mosh             强制使用 mosh
    --ssh              强制使用 ssh
    --dry-run          只显示路径不连接

文件:
  files push <src> [dst]   上传文件到工作站
  files pull <src> [dst]   从工作站下载文件
  files list [path]        远程目录列表

端口转发:
  forward <port>           转发工作站:port 到 localhost:port

状态:
  status                   健康检查
  status --json            JSON 输出
  fix                      诊断+修复
  fix --dry-run            只诊断不修复

服务:
  desktop                  RustDesk 远程桌面
  code                     code-server Web IDE
  runner status            Runner 状态
  runner restart           Runner 重启
  runner logs [service]    Runner 日志

管理:
  config                   查看配置
  update                   自更新
  uninstall                卸载
  --version                版本号

示例:
  remote connect              # 自动选路连接
  remote connect --dry-run    # 只显示路径
  remote files push ./file.txt  # 上传文件
  remote files pull /remote/file.txt ./local.txt  # 下载文件
  remote forward 8188         # 转发 ComfyUI 端口
  remote status --json        # JSON 格式状态
HELP
        ;;
    *)
        error "未知命令: $cmd"
        echo "运行 remote --help 查看可用命令"
        exit 1
        ;;
esac
